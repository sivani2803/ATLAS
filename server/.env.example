# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (MongoDB Atlas or Local MongoDB)
# Example Atlas: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/landslide_db?retryWrites=true&w=majority
# Example Local: mongodb://localhost:27017/landslide_db
MONGODB_URI=mongodb+srv://kesanasivani2803_db_user:paathadhey123@cluster0.afcsxmw.mongodb.net/landslide_db
USE_MEMORY_DB=false
# Set to true to force embedded in-memory MongoDB for instant zero-config evaluation

# Security & Authentication
JWT_SECRET=super_secret_jwt_key_landslide_cinematic_earth_intelligence_2026
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173

# Edge IoT Hardware Ingestion Secret
SENSOR_INGESTION_KEY=landslide_edge_telemetry_secure_key_9981

# Optional External Notification Services (Twilio SMS / SendGrid Email)
# If omitted, alerts are recorded in-app and delivery status will explicitly state "external_unconfigured"
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
SENDGRID_API_KEY=
ALERT_EMAIL_FROM=alerts@earth-intel.landslide.org
