# Frontend Telemetry and API Endpoint Configuration
VITE_API_URL=http://localhost:5000/api
VITE_SOCKET_URL=http://localhost:5000

# Verified Keyless Base Map Providers (OpenStreetMap & Esri World Imagery/Topo)
VITE_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_MAP_ATTRIBUTION=&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors

# Optional Provider API Keys (if using custom Mapbox, Stadia, or Carto Enterprise in production)
VITE_MAP_API_KEY=
